# 复制为 .env 后填写。所有配置项的说明和默认值见 app/core/config.py。
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- 必填 ----------

# 登录令牌签名密钥，至少 32 位。更换后所有用户需要重新登录。
JWT_SECRET_KEY="change_me_to_a_random_string"

# PostgreSQL 和 Elasticsearch 的密码。只在第一次创建数据卷时生效，之后修改要同时改数据库里的密码。
POSTGRES_PASSWORD="change_me"
ELASTIC_PASSWORD="change_me"

# 对话模型，OpenAI 兼容接口
DASHSCOPE_API_KEY="your_api_key"
DASHSCOPE_BASE_URL="https://api.teamorouter.cn/v1"
CHAT_MODEL="gpt-6.1-sol"

# 向量和重排走阿里云百炼北京地域，不要填对话中转站的 Key
EMBEDDING_API_KEY="your_dashscope_api_key"

# ---------- 选填 ----------

# 重排默认复用 EMBEDDING_API_KEY
# RERANK_API_KEY=
# RERANK_MODEL="qwen3.7-text-rerank"

# 语音识别（Token Plan 套餐专属地址）
ASR_API_KEY="your_token_plan_api_key"
# ASR_MODEL="qwen-audio-3.0-asr-flash"
# ASR_BASE_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# API 进程数。每个进程约 400MB 内存
API_WORKERS=2
# Elasticsearch 堆内存和容器内存上限（字节）
ES_HEAP=512m
MEM_LIMIT=2147483648
TIMEZONE=Asia/Shanghai

# 允许跨域访问的前端地址，逗号分隔。通过 Vite 代理或同域部署时不需要
# CORS_ORIGINS=https://your-frontend.example.com

LOG_LEVEL=INFO

# 多轮对话：带最近几轮历史；改写追问用的模型（留空则用 CHAT_MODEL，换成更快的小模型能缩短追问等待）
# CHAT_HISTORY_TURNS=5
# REWRITE_MODEL=

# 检索参数
# CHUNK_TOKEN_NUM=128
# RETRIEVAL_TOP_K=5
# VECTOR_SIMILARITY_WEIGHT=0.6
# SIMILARITY_THRESHOLD=0.1
# MAX_UPLOAD_MB=10

# 在宿主机上直接运行后端（不用 Docker）时才需要。Docker 部署由 docker-compose.yml 覆盖
# DATABASE_URL=postgresql://postgres:<密码>@localhost:5432/gsk
# ES_HOST=http://localhost:9200
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./data/files
